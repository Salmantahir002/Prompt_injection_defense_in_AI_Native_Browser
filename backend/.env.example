APP_NAME="Prompt Injection Defense Browser Backend"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
CORS_ALLOWED_ORIGINS="http://localhost:5173"
MODEL_DIR="app/ml_models/prompt_injection_model"
CLASSIFIER_THRESHOLD="0.70"
DEFAULT_CHUNK_SIZE="800"
DEFAULT_CHUNK_OVERLAP="100"
# OpenCode Zen (https://opencode.ai/docs/zen/)
OPENCODE_ZEN_API_KEY="replace_with_your_key"
OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"
# Model id only, no "opencode/" prefix — see https://opencode.ai/zen/v1/models for the full list
OPENCODE_ZEN_MODEL="replace_with_selected_model"
# Set to False to bypass SSL verification if experiencing connection/proxy certification issues
OPENCODE_ZEN_VERIFY_SSL="True"
