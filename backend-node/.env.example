APP_NAME="Prompt Injection Defense Browser Backend"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
PORT="8000"
CORS_ALLOWED_ORIGINS="http://localhost:5173"
MODEL_DIR="ml_models/prompt_injection_model"
CLASSIFIER_THRESHOLD="0.70"
DEFAULT_CHUNK_SIZE="800"
DEFAULT_CHUNK_OVERLAP="100"
AGENT_MIN_CONFIDENCE="0.60"

# No LLM provider credentials live here. Every provider (OpenAI, Anthropic,
# Gemini, OpenCode Zen, NVIDIA, Cloudflare, AgentRouter, Custom) is connected at
# runtime from the app's Settings screen with the user's own API key; the key is
# stored encrypted by the Electron process and only the active provider is
# synced to this backend over POST /api/v1/providers/active.
